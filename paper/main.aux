\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Two-level view of noise trajectory search. The \emph  {global scheduler}~$\mathcal  {G}$ (top) receives budget~$B$ and distributes per-step budgets $\{K_t\}$ across the denoising trajectory. At each timestep, the \emph  {local search operator}~$\mathcal  {L}_t$ (bottom) evaluates $K_t$ noise candidates and selects the best one. Bars above each step depict the non-uniform allocation: timesteps where noise perturbations matter more receive larger budgets.}}{7}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{7}{Two-level view of noise trajectory search. The \emph {global scheduler}~$\mathcal {G}$ (top) receives budget~$B$ and distributes per-step budgets $\{K_t\}$ across the denoising trajectory. At each timestep, the \emph {local search operator}~$\mathcal {L}_t$ (bottom) evaluates $K_t$ noise candidates and selects the best one. Bars above each step depict the non-uniform allocation: timesteps where noise perturbations matter more receive larger budgets}{figure.caption.7}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][7][]7}}
