\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Online stopping decision in the $(\sigma _t, a_K')$ plane. The variance threshold (vertical dashed) and gain threshold (horizontal dashed) partition the space into four regions. Stopping is triggered only when \emph  {both} conditions are met (shaded region), corresponding to the conjunction in \cref  {prop:online}(ii). The hyperbola $\sigma _t\cdot a_K'=\lambda ^*$ shows the true optimality boundary; the rectangular approximation is conservative by design.}}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:stopping}{{2}{14}{Online stopping decision in the $(\sigma _t, a_K')$ plane. The variance threshold (vertical dashed) and gain threshold (horizontal dashed) partition the space into four regions. Stopping is triggered only when \emph {both} conditions are met (shaded region), corresponding to the conjunction in \cref {prop:online}(ii). The hyperbola $\sigma _t\cdot a_K'=\lambda ^*$ shows the true optimality boundary; the rectangular approximation is conservative by design}{figure.caption.11}{}}
\newlabel{fig:stopping@cref}{{[figure][2][]2}{[1][14][]14}}
